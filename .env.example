# =========================================================================
# FormFlow - Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env em produção e defina senhas seguras
# =========================================================================

# Configurações do Banco de Dados PostgreSQL
POSTGRES_USER=formflow_user
POSTGRES_PASSWORD=SubstituaPorUmaSenhaForte2026!
POSTGRES_DB=formflow_db

# String de Conexão Prisma / Next.js
DATABASE_URL=postgresql://formflow_user:SubstituaPorUmaSenhaForte2026!@postgres:5432/formflow_db?schema=public

# Chave secreta de sessão (Gere com: openssl rand -hex 32)
SESSION_SECRET=substitua_por_uma_chave_secreta_aleatoria_com_pelo_menos_32_caracteres_hex

# Domínio público ou IP da sua VM Proxmox
NEXT_PUBLIC_APP_URL=https://forms.seudominio.com.br

# Credenciais de Inicialização do Primeiro Administrador
ADMIN_INITIAL_EMAIL=admin@formflow.local
ADMIN_INITIAL_PASSWORD=FormFlow@2026!Admin

# Porta de Execução do Container
PORT=3004

# Cloudflare Tunnel Token (Opcional - necessário caso utilize o profile cloudflare)
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
